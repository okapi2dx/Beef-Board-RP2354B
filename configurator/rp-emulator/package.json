{
  "name": "beef-board-rp-emulator",
  "version": "1.0.0",
  "description": "Standalone RP2354B mock HID configurator",
  "author": "Beef Board contributors",
  "license": "GPL-3.0-only",
  "main": "main.cjs",
  "scripts": {
    "build:ui": "node build.cjs",
    "test": "node test.cjs",
    "start": "npm run build:ui && node ../desktop/node_modules/electron/cli.js .",
    "dist": "npm run build:ui && node ../desktop/node_modules/electron-builder/out/cli/cli.js --win portable --x64"
  },
  "build": {
    "appId": "io.github.okapi2dx.beefboard.rp-emulator",
    "productName": "Beef Board RP Emulator",
    "electronVersion": "44.3.0",
    "electronDist": "../desktop/node_modules/electron/dist",
    "asar": true,
    "directories": { "output": "dist" },
    "files": ["main.cjs", "package.json", "ui/**/*"],
    "win": { "target": "portable", "signAndEditExecutable": false },
    "portable": { "artifactName": "Beef-Board-RP-Emulator-V1.00.exe", "unpackDirName": false }
  }
}
